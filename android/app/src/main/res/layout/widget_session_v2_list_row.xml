<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_v2_card" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
<TextView android:id="@+id/widget_v2_title" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="12sp" android:textStyle="bold" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widgetText" />
<LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
<ProgressBar android:id="@+id/widget_v2_progress" android:layout_width="12dp" android:layout_height="12dp" android:indeterminate="true" android:indeterminateTint="@color/widgetAccent" />
<Chronometer android:id="@+id/widget_v2_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widgetHint" />
<TextView android:id="@+id/widget_v2_step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/widgetHint" />
</LinearLayout></LinearLayout>
<TextView android:id="@+id/widget_v2_tasks" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
<LinearLayout android:orientation="horizontal" android:id="@+id/widget_v2_todos" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
<TextView android:id="@+id/widget_v2_primary" android:layout_width="wrap_content" android:minWidth="64dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widgetAccent" />
<TextView android:id="@+id/widget_v2_secondary" android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" android:maxLines="2" android:textColor="@color/widgetAccent" />
</LinearLayout>
