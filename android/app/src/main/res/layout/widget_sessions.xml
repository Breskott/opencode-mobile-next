<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@drawable/widget_background" android:padding="4dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/widget_v2_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widgetText" android:maxLines="2" />
<TextView android:id="@+id/widget_v2_voice" android:layout_width="36dp" android:layout_height="26dp" android:gravity="center" android:text="@string/widget_v2_voice" android:textColor="@color/widgetAccent" android:textSize="12sp" />
<TextView android:id="@+id/widget_v2_configure" android:layout_width="36dp" android:layout_height="26dp" android:gravity="center" android:text="@string/widget_v2_configure" android:textColor="@color/widgetAccent" android:textSize="12sp" />
</LinearLayout><LinearLayout android:id="@+id/widget_v2_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" /></LinearLayout>
