<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_v2_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="2dp">
<TextView android:id="@+id/widget_v2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widgetText" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="18dp" android:gravity="center_vertical">
<ProgressBar android:id="@+id/widget_v2_progress" android:layout_width="16dp" android:layout_height="16dp" android:indeterminate="true" android:indeterminateTint="@color/widgetAccent" />
<Chronometer android:id="@+id/widget_v2_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:layout_marginStart="4dp" android:textColor="@color/widgetHint" />
<TextView android:id="@+id/widget_v2_step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:maxLines="2" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/widgetHint" />
</LinearLayout>
<TextView android:id="@+id/widget_v2_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widgetHint" android:visibility="gone" />
<LinearLayout android:id="@+id/widget_v2_todos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<LinearLayout android:layout_width="match_parent" android:layout_height="32dp">
<TextView android:id="@+id/widget_v2_primary" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetAccent" />
<TextView android:id="@+id/widget_v2_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="@color/widgetAccent" />
</LinearLayout>
</LinearLayout>
