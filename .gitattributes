# Merge rules for the parallel revamp (docs/ux-system/revamp/PLAN.md §6, R04 and R09).
# The drivers are repo-local git config; the integrator sets them once (PLAN.md §8):
#   git config merge.arbunion.name "ARB 3-way key union"
#   git config merge.arbunion.driver "python3 tool/l10n/arb_merge.py %O %A %B %P"
#   git config merge.ours.name "keep ours (regenerated after the merge)"
#   git config merge.ours.driver true

# Copy: a 3-way union of keys; fails only when one key gets two different values.
lib/l10n/*.arb merge=arbunion

# Generated by gen-l10n after every merge: keep ours, and keep it out of diffs.
lib/l10n/app_localizations*.dart merge=ours -diff

# Generated by docs/design/ui-ledger/build_ledger.py after every integration.
docs/design/ui-ledger/ledger.json merge=ours
docs/design/ui-ledger/pages.md merge=ours
docs/design/ui-ledger/navigation.md merge=ours
